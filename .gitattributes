# Normalise text files to LF in the repository
* text=auto

# Windows batch files must keep CRLF line endings or cmd.exe can misread labels/goto
*.bat text eol=crlf

# Source and docs
*.cpp text
*.hpp text
*.h   text
*.md  text
Makefile text eol=lf
CMakeLists.txt text

# Binaries: never touch line endings, never diff
*.exe binary
*.dll binary
*.png binary
*.gif binary
*.zip binary
